# ---- PostgreSQL учёта времени (и БД n8n в том же сервере) ----
TT_DB_USER=timetrack
TT_DB_PASSWORD=change-me-strong-password
TT_DB_NAME=timetrack

# ---- n8n ----
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Moscow
# 32+ случайных символов: openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-random-32-chars
# сколько часов хранить данные выполнений (в них могут быть снимки, присланные как base64)
EXECUTIONS_DATA_MAX_AGE=168
N8N_PAYLOAD_SIZE_MAX=16

# ---- CompreFace ----
CF_REGISTRY=exadel/
CF_VERSION=1.2.0
CF_UI_PORT=8000
CF_DB_USER=postgres
CF_DB_PASSWORD=postgres
CF_API_JAVA_OPTS=-Xmx2g
CF_ADMIN_JAVA_OPTS=-Xmx1g
CF_MAX_FILE_SIZE=5MB
CF_MAX_REQUEST_SIZE=10MB
CF_MAX_DETECT_SIZE=640
CF_UWSGI_PROCESSES=2
CF_UWSGI_THREADS=1
