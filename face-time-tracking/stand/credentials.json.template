[
  {
    "id": "timetrack-postgres",
    "name": "Timetrack Postgres",
    "type": "postgres",
    "data": {
      "host": "${TT_DB_HOST}",
      "port": ${TT_DB_PORT},
      "database": "${TT_DB_NAME}",
      "user": "${TT_DB_USER}",
      "password": "${TT_DB_PASSWORD}",
      "ssl": "disable",
      "allowUnauthorizedCerts": false,
      "maxConnections": 20
    }
  },
  {
    "id": "timetrack-compreface-key",
    "name": "CompreFace Recognition API Key",
    "type": "httpHeaderAuth",
    "data": {
      "name": "x-api-key",
      "value": "${CF_API_KEY}"
    }
  },
  {
    "id": "timetrack-hr-api",
    "name": "HR System API",
    "type": "httpHeaderAuth",
    "data": {
      "name": "Authorization",
      "value": "Bearer ${HR_API_TOKEN}"
    }
  },
  {
    "id": "timetrack-smtp",
    "name": "Timetrack SMTP",
    "type": "smtp",
    "data": {
      "user": "${SMTP_USER}",
      "password": "${SMTP_PASSWORD}",
      "host": "127.0.0.1",
      "port": ${SMTP_PORT},
      "secure": false,
      "disableStartTls": true
    }
  }
]
