# Скопируйте в stand/.env и задайте значения. Файл .env не коммитится.

# Обязательно: ключ шифрования учётных данных n8n.
# Сгенерировать: openssl rand -hex 16
N8N_ENCRYPTION_KEY=

# База учёта рабочего времени. Пароль можно оставить пустым, если
# PostgreSQL настроен на доверительную аутентификацию с localhost.
TT_DB_HOST=127.0.0.1
TT_DB_PORT=54329
TT_DB_NAME=timetrack
TT_DB_USER=postgres
TT_DB_PASSWORD=
# Каталог кластера PostgreSQL, который поднимает up.sh
PGDATA=

# Заглушки внешних сервисов. Значения ниже ничего не защищают — заглушки
# слушают только localhost, — но должны совпадать в заглушке и в credentials.
CF_API_KEY=stub-recognition-key
HR_API_TOKEN=stub-hr-token
SMTP_USER=timetrack@example.com
SMTP_PASSWORD=stub-smtp-password

# Где жить каталогу стенда (база n8n, письма, токены). По умолчанию ~/n8n-stand
STAND_HOME=
