{
  "id": "fI0ug35JWhvro7vy",
  "name": "Timetrack 00 — Error Handler",
  "nodes": [
    {
      "parameters": {
        "content": "## Обработчик ошибок\nНазначьте этот воркфлоу как **Error Workflow** в настройках каждого воркфлоу Timetrack (Settings → Error workflow). При сбое администратор получает письмо с именем воркфлоу, узла и текстом ошибки, а факт сбоя записывается в `timetrack.audit_log`.",
        "height": 150,
        "width": 1100,
        "color": 4
      },
      "id": "9a6dbcb3-6884-570b-8c3c-38c21dd3fdbe",
      "name": "Sticky Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        -100
      ]
    },
    {
      "parameters": {},
      "id": "7d8bdfbc-4cdf-55b5-88eb-e44589150b32",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "01f89afe-2803-5a13-93e8-2174b3d21bc9",
              "name": "adminEmail",
              "value": "admin@example.com",
              "type": "string"
            },
            {
              "id": "ceace514-67fe-5cbd-a539-ec4388bd9d88",
              "name": "fromEmail",
              "value": "timetrack@example.com",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "5bc929c8-504f-54d3-8be6-a4cc5cd5d8a3",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT timetrack.fn_audit('n8n', 'system', 'workflow.failed', 'workflow', $1, $2::jsonb) AS audit_id",
        "options": {
          "queryReplacement": "={{ [ $('Error Trigger').first().json.workflow?.name ?? 'unknown', ({ execution_id: $('Error Trigger').first().json.execution?.id ?? null, node: $('Error Trigger').first().json.execution?.lastNodeExecuted ?? null, message: $('Error Trigger').first().json.execution?.error?.message ?? null, url: $('Error Trigger').first().json.execution?.url ?? null }) ] }}"
        }
      },
      "id": "22c0a0a1-81bb-55ca-a1e1-8b024e63e754",
      "name": "Audit Failure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        720,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "timetrack-postgres",
          "name": "Timetrack Postgres"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').first().json.fromEmail }}",
        "toEmail": "={{ $('Config').first().json.adminEmail }}",
        "subject": "=[Учёт времени] Сбой воркфлоу «{{ $('Error Trigger').first().json.workflow?.name ?? 'unknown' }}»",
        "emailFormat": "html",
        "html": "=<p>Воркфлоу <b>{{ $('Error Trigger').first().json.workflow?.name ?? 'unknown' }}</b> завершился с ошибкой.</p><ul><li>Узел: {{ $('Error Trigger').first().json.execution?.lastNodeExecuted ?? '—' }}</li><li>Ошибка: {{ String($('Error Trigger').first().json.execution?.error?.message ?? '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c])) }}</li><li>Выполнение: <a href=\"{{ $('Error Trigger').first().json.execution?.url ?? '#' }}\">{{ $('Error Trigger').first().json.execution?.id ?? '—' }}</a></li></ul>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "771161e0-484a-548d-b1d5-c500876a4df3",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "timetrack-smtp",
          "name": "Timetrack SMTP"
        }
      },
      "onError": "stopWorkflow"
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Audit Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Audit Failure": {
      "main": [
        [
          {
            "node": "Send Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveExecutionProgress": false,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "UTC"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Уведомление администратора и запись в аудит при сбое любого воркфлоу учёта времени",
    "tags": [
      "timetrack"
    ]
  },
  "active": false
}
