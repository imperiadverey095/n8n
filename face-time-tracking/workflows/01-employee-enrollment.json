    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH e AS (\n  SELECT * FROM timetrack.fn_upsert_employee($1, $2, $3, $4, $5, $6, $7::jsonb, $8, 'active', $9)\n), c AS (\n  SELECT timetrack.fn_grant_consent(e.employee_id, $10, $11, $12, $9) AS consent_id FROM e\n)\nSELECT e.employee_id, e.full_name, e.email, e.timezone, c.consent_id FROM e, c",
        "options": {
          "queryReplacement": "={{ [ $json.employee_id, $json.full_name, $json.email ?? null, $json.department ?? null, $json.position ?? null, $json.timezone ?? null, $json.work_schedule ?? null, $json.hr_external_id ?? null, $json.actor ?? null, $('Config').first().json.consentVersion, $json.consent_via ?? null, $json.consent_document_ref ?? null ] }}"
        }
      },
      "id": "e4aac5bc-b039-563a-a7bf-ecaebc1f59ae",
      "name": "Upsert Employee And Consent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1840,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "timetrack-postgres",
          "name": "Timetrack Postgres"
        }
      },
      "notes": "fn_upsert_employee + fn_grant_consent в одной транзакции. Согласие фиксируется до загрузки биометрии.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Postgres-нода отдаёт только колонки запроса и теряет binary, поэтому снимок и\n// остальные поля (в том числе actor для аудита) возвращаются из шага валидации.\nconst validated = $('Validate Enrollment').first();\nconst info = { ...validated.json, ...$input.first().json };\nreturn [{ json: info, binary: validated.binary }];\n"
      },
