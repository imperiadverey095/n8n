      "id": "6f44eb36-1927-5073-a206-aa1f8349225c",
      "name": "Register Face",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2400,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "timetrack-compreface-key",
          "name": "CompreFace Recognition API Key"
        }
      },
      "notes": "Добавляет пример лица к subject = employee_id (subject создаётся автоматически).",
      "notesInFlow": true,
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Ответ CompreFace POST /api/v1/recognition/faces?subject=...\nconst info = $('Attach Image').first();\nconst resp = $input.first().json;\nconst status = Number(resp.statusCode ?? 0);\nconst body = resp.body ?? {};\nconst out = { ...info.json, ok: false, code: null, http_status: 200, message: '', face_id: null, subject: null };\nif (resp.error || status === 0 || status >= 500) {\n  out.code = 'face_service_unavailable'; out.http_status = 502;\n  out.message = 'Сервис распознавания недоступен' + (status ? ' (HTTP ' + status + ')' : '');\n} else if (status === 400 && (body.code === 28 || /no face/i.test(body.message || ''))) {\n  out.code = 'no_face'; out.http_status = 422; out.message = 'На снимке не найдено лицо — нужен фронтальный снимок';\n} else if (status === 401 || status === 403) {\n  out.code = 'face_service_auth'; out.http_status = 502; out.message = 'Неверный API-ключ сервиса распознавания';\n} else if (status === 200 || status === 201) {\n  out.ok = true; out.code = 'enrolled';\n  out.face_id = body.image_id ?? null;\n  out.subject = body.subject ?? info.json.employee_id;\n} else {\n  out.code = 'face_service_error'; out.http_status = 502; out.message = body.message || ('HTTP ' + status);\n}\nreturn [{ json: out, binary: info.binary }];\n"
      },
