        }
      },
      "id": "2ffbe3e1-bb43-5074-8da5-179c8b21938c",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1560,
        1140
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "employees",
        "include": "noOtherFields",
        "options": {}
      },
      "id": "8f5ab851-93ca-5dd9-8e73-5a5bea447daa",
      "name": "Split Employees",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1560,
        940
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT employee_id, full_name, status, updated_at\n  FROM timetrack.fn_upsert_employee($1, $2, $3, $4, $5, $6, $7::jsonb, $8, $9, $10)",
        "options": {
          "queryReplacement": "={{ [ $json.employee_id, $json.full_name, $json.email ?? null, $json.department ?? null, $json.position ?? null, $json.timezone ?? null, $json.work_schedule ?? null, $json.hr_external_id ?? null, $json.status ?? null, $('Validate Payload').first().json.actor ?? null ] }}",
          "queryBatching": "independently"
        }
      },
      "id": "a18cb051-2047-5354-a248-4dd922d1587a",
      "name": "Upsert Employee",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1840,
        940
      ],
      "credentials": {
        "postgres": {
          "id": "timetrack-postgres",
          "name": "Timetrack Postgres"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst failed = items.filter((i) => i.json && i.json.error);\nreturn [{ json: {\n  ok: failed.length === 0,\n  processed: items.length,\n  updated: items.length - failed.length,\n  failed: failed.length,\n  errors: failed.slice(0, 20).map((i) => String(i.json.error && i.json.error.message ? i.json.error.message : i.json.error)),\n} }];\n"
      },
      "id": "8a8636d7-a5b9-5487-8af1-d67bad906890",
      "name": "Summarize Sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        940
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "d1b671de-300b-5c84-b7e0-35a2b638cd8a",
      "name": "Respond Sync Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2400,
        940
      ]
    }
  ],
