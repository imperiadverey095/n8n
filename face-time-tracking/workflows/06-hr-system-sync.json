    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.hrSystemUrl }}",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "batching": {
            "batch": {
              "batchSize": 10,
              "batchInterval": 500
            }
          }
        },
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ id: $json.id, kind: $json.event_kind, entity_type: $json.entity_type, entity_id: $json.entity_id, created_at: $json.created_at, attempt: $json.attempts, data: $json.payload }) }}"
      },
      "id": "fbf5f8aa-fb04-5194-8cf0-a843e38da91f",
      "name": "Push To HR System",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        300
