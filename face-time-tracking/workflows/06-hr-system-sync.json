          "name": "HR System API"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Результат доставки одного события outbox в HR-систему.\nconst resp = $json;\nconst src = $('Claim Outbox Batch').item.json;\nconst status = Number(resp.statusCode ?? 0);\nconst ok = !resp.error && status >= 200 && status < 300;\nlet error = null;\nif (!ok) {\n  const detail = resp.error ? (resp.error.message || JSON.stringify(resp.error)) : JSON.stringify(resp.body ?? '');\n  error = ('HTTP ' + status + ' ' + String(detail)).slice(0, 1500);\n}\nreturn { json: { outbox_id: src.id, event_kind: src.event_kind, ok, error } };\n"
      },
      "id": "758cc87e-6d21-563c-b204-5732fd5f8949",
      "name": "Evaluate Delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
